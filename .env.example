# Kopieer naar .env en vul je echte key in. .env niet delen of committen.
NOLAI_API_KEY=sk-xxxxxxxx
# LM Studio controleert de key niet; de waarde mag alles zijn.
LMSTUDIO_API_KEY=lm-studio
# Adres van je LM Studio-server (host:poort) voor het lokale model (speler O).
LMSTUDIO_HOST=192.168.1.50:1234
